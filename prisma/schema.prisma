generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mysql"
    url      = env("PRISMA_DATABASE_URL")
}

model User {
    id        Int      @id @default(autoincrement())
    email     String   @unique
    name      String?
    password  String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    posts     Post[]
    role      Role     @relation(fields: [roleId], references: [id])
    roleId    Int
    profile   Profile?
}

model Role {
    id          Int          @id @default(autoincrement())
    name        String       @unique
    createdAt   DateTime     @default(now())
    updatedAt   DateTime     @updatedAt
    users       User[]
    permissions Permission[] @relation("RolePermissions")
}

model Permission {
    id        Int      @id @default(autoincrement())
    name      String   @unique
    createdAt DateTime @default(now())
    updatedAt DateTime @default(now())
    roles     Role[]   @relation("RolePermissions")
}

model Profile {
    id        Int      @id @default(autoincrement())
    bio       String?
    userId    Int      @unique
    user      User     @relation(fields: [userId], references: [id])
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Post {
    id         Int           @id @default(autoincrement())
    title      String
    content    String
    published  Boolean       @default(false)
    author     User?         @relation(fields: [authorId], references: [id])
    authorId   Int?
    createdAt  DateTime      @default(now())
    updatedAt  DateTime      @updatedAt
    categories Category[]    @relation("PostCategories")
    pages      Page[]        @relation("PagesPosts")
    blocks     PostsBlocks[] // Agregar relación con bloques
}

model Page {
    id        Int      @id @default(autoincrement())
    title     String
    content   String
    slug      String   @unique
    published Boolean  @default(false)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    posts     Post[]   @relation("PagesPosts")
}

model PagesPosts {
    pageId Int
    postId Int
    order  Int

    @@id([pageId, postId])
    @@index([postId])
    @@index([pageId])
    @@map("pages_posts")
}

model Category {
    id        Int      @id @default(autoincrement())
    name      String   @unique
    createdAt DateTime @default(now())
    updatedAt DateTime @default(now())
    posts     Post[]   @relation("PostCategories")
}

model PostCategories {
    postId     Int
    categoryId Int
    createdAt  DateTime @default(now())

    @@id([postId, categoryId])
    @@index([categoryId])
    @@index([postId])
    @@map("post_categories")
}

model Block {
    id        Int           @id @default(autoincrement())
    name      String
    content   String        @db.Text
    headline  String?       @db.VarChar(255)
    type      BlockType     @default(TEXT) // Agregar enum para tipos
    images    BlockImage[]
    videos    BlockVideo[]
    urls      Json?
    posts     PostsBlocks[] // Agregar relación con posts
    createdAt DateTime      @default(now())
    updatedAt DateTime      @updatedAt

    @@index([type])
}

model PostsBlocks {
    post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
    block     Block    @relation(fields: [blockId], references: [id], onDelete: Cascade)
    postId    Int
    blockId   Int
    order     Int
    createdAt DateTime @default(now())

    @@id([postId, blockId])
    @@index([blockId])
    @@index([postId])
    @@map("posts_blocks")
}

model BlockImage {
    id        Int      @id @default(autoincrement())
    url       String   @db.Text
    alt       String?  @db.VarChar(255)
    width     Int?
    height    Int?
    order     Int      @default(0)
    block     Block    @relation(fields: [blockId], references: [id], onDelete: Cascade)
    blockId   Int
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([blockId])
}

model BlockVideo {
    id        Int      @id @default(autoincrement())
    url       String   @db.Text
    alt       String?  @db.VarChar(255)
    width     Int?
    height    Int?
    block     Block    @relation(fields: [blockId], references: [id], onDelete: Cascade)
    blockId   Int
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([blockId])
}

enum BlockType {
    TEXT
    IMAGE
    VIDEO
    GALLERY
    EMBED
    CODE
}
